# Copy to .env and fill in. Never commit .env.

# openai | openrouter | groq | custom
AI_PROVIDER=openrouter

# Your provider token
AI_API_KEY=

# GitHub PAT for worker --push and `gh` / pages:deploy (repo + workflow scopes).
# Not used by plain `git push` unless you run the worker or export it yourself.
# GITHUB_TOKEN=

# Display name + runs/<slug>/ folder (README Model column)
AI_MODEL=Qwen3.8-Flash-Next-UD-Q4_K_XL

# Runtime shown in README Engine column (gufo | llamacpp | vllm | …)
# AI_ENGINE=gufo
# AI_ENGINE_LINK=https://github.com/gufo-org/gufo

# Optional: gateway route id for /v1/chat/completions only (NOT shown as Model).
# If unset, AI_MODEL is used for the API too.
# Example (halogen down → onprem alias "chat"):
# AI_MODEL_API=chat
# AI_MODEL_API=coder

# Optional — overrides the provider default base URL
# AI_BASE_URL=https://openrouter.ai/api/v1

# Live thinking dump in terminal (default: off)
# THINKING_ENABLED=true

# SSE stream for long builds (default: true). Keeps connection alive.
# AI_STREAM=true

# Wait for slots_idle>=1 via GET /v1/models before each completion (default: true)
# WAIT_FOR_SLOT=true
# SLOT_POLL_MS=15000

# Autonomous worker (multi-day)
# WORKER_MAX_PARALLEL=2
# WORKER_FILL=true
# WORKER_FILL_N=10
# WORKER_FILL_WHEN_BELOW=1
# WORKER_COMMIT=true
# WORKER_IDLE_MS=20000
