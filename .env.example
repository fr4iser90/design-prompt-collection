# Copy to .env and fill in. Never commit .env.

# openai | openrouter | groq | custom
AI_PROVIDER=openrouter

# Your provider token
AI_API_KEY=

# Label for runs/<slug>/ + meta (can be a friendly alias)
AI_MODEL=halogen-qwen3.8-flash-next

# Optional: real model id sent to /v1/chat/completions
# If unset, AI_MODEL is used for the API too.
# Example (halogen down → onprem chat):
# AI_MODEL_API=chat
# AI_MODEL_API=coder

# Optional — overrides the provider default base URL
# AI_BASE_URL=https://openrouter.ai/api/v1

# Live thinking dump in terminal (default: off)
# THINKING_ENABLED=true

# SSE stream for long builds (default: true). Keeps connection alive.
# AI_STREAM=true

# Wait for slots_idle>=1 via GET /v1/models before each completion (default: true)
# WAIT_FOR_SLOT=true
# SLOT_POLL_MS=15000

# Autonomous worker (multi-day)
# WORKER_MAX_PARALLEL=2
# WORKER_FILL=true
# WORKER_FILL_N=10
# WORKER_FILL_WHEN_BELOW=1
# WORKER_COMMIT=true
# WORKER_IDLE_MS=20000
