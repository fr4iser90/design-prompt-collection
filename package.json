{
  "name": "design-prompt-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "High-refined design prompts for landing pages, animations, and concepts",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "hooks": "node scripts/install-hooks.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node scripts/check-complete.mjs",
    "build": "node scripts/validate.mjs && node scripts/generate.mjs",
    "ai:fill": "node scripts/ai-fill.mjs",
    "ai:new": "node scripts/ai-fill.mjs",
    "ai:lanes": "node scripts/ai-fill.mjs --list-lanes",
    "ai:build": "node scripts/ai-build.mjs",
    "shots": "node scripts/shots.mjs",
    "playwright:install": "node node_modules/playwright/cli.js install chromium",
    "review": "node scripts/review.mjs",
    "pages": "node scripts/pages.mjs",
    "pages:deploy": "node scripts/deploy-pages.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "ship": "node scripts/ship.mjs",
    "worker": "node scripts/worker.mjs",
    "worker:status": "node scripts/worker.mjs --status",
    "stop": "node scripts/stop-worker.mjs",
    "slots": "node scripts/slots-status.mjs",
    "migrate:runs": "node scripts/migrate-run-slug.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
