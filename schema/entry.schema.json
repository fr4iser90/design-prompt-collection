{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/design-prompt-collection/entry.schema.json",
  "title": "DesignPromptEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "tags",
    "status",
    "summary",
    "preview",
    "prompt",
    "extended",
    "created"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Must match the folder name"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "category": {
      "type": "string",
      "enum": [
        "landing-pages",
        "animations",
        "concepts",
        "games",
        "webgl",
        "editorial",
        "interfaces",
        "experiments"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "polished", "archived"]
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220,
      "description": "One-line teaser for README / index"
    },
    "preview": {
      "type": "string",
      "pattern": "^(preview\\.(svg|png|webp|jpg|jpeg)|runs/[a-z0-9-]+/preview\\.(svg|png|webp|jpg|jpeg))$"
    },
    "prompt": {
      "type": "string",
      "const": "prompt.md"
    },
    "extended": {
      "type": "string",
      "const": "prompt.full.md"
    },
    "demo": {
      "type": ["string", "null"],
      "description": "Relative path to default demo, typically runs/<model>/demo/index.html"
    },
    "default_run": {
      "type": ["string", "null"],
      "description": "model-slug folder under runs/"
    },
    "source_model": {
      "type": ["string", "null"],
      "description": "Model that wrote the prompt brief"
    },
    "source_provider": {
      "type": ["string", "null"]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "model_hints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Target tools / models this prompt works well with"
    }
  }
}
